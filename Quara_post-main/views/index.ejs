<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>All posts</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/style.css"> <!-- ensure path correct -->
</head>
<body>
<nav class="navbar sticky-top bg-body-tertiary p-3 text-primary-emphasis bg-primary-subtle border rounded-3">
  <div class="container-fluid">
   <a class="navbar-brand" href="http://localhost:9000/posts">
  <img src="/images/quora-logo.svg" alt="Quora Logo" height="50">
          <g transform="translate(18,16)">
            <circle cx="46" cy="46" r="46" fill="#B92B27"/>
            <circle cx="46" cy="38" r="26" fill="#fff"/>
            <path d="M52 58 L86 92 L78 94 L44 62 Z" fill="#fff"/>
            <path d="M48 52 L62 66 L56 70 L42 56 Z" fill="#B92B27"/>
          </g>
          <text x="120" y="90" font-family="Georgia, 'Times New Roman', serif"
                font-size="72" font-weight="700" fill="#B92B27" letter-spacing="1">
        
          </text>
        </svg>
      </a>
    <form class="d-flex" role="search">
      <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" />
      <button class="btn btn-outline-success" type="submit">Submit</button>
    </form>
  </div>
</nav>

<!-- put container once, outside loop -->
<div class="container-md mt-3">

  <% for (post of posts) { %>
    <div class="card post-card">
      <div class="card-header text-bg-primary text-center py-2">
        <h6 class="mb-0">Post ID : <%= post.id %></h6>
      </div>

      <div class="card-body text-center py-2">
        <h6 class="card-title mb-1">@<%= post.username %></h6>
        <!-- use class for avatar size instead of width="10%" -->
        <img src="<%= post.image %>" alt="<%= post.username %>" class="post-avatar rounded-circle mb-2">
        <p class="card-text mb-2"><%= post.content %></p>

        <div class="d-flex justify-content-center gap-2">
          <a href="/posts/<%= post.id %>" class="btn btn-primary btn-sm">See Details</a>
          <a href="/posts/<%= post.id %>/edit" class="btn btn-primary btn-sm">Edit Post</a>
            
        </div>
      </div>
    </div>
  <% } %>

  <div class="d-flex justify-content-start mt-3">
    <a href="/posts/new" class="btn btn-primary btn-sm">Create New Post</a>
  </div>

</div> <!-- container-md -->
</body>
</html>
