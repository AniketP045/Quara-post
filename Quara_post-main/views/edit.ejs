<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
     <%- include("includes/nav.ejs") %>
     <br>

    <div class="container-md">
        <h2>Edit your post</h2>
        
            <div class="mb-3">
                <label for="exampleFormControlInput1" class="form-label"><b>Post Id : </b><%= post.id %></label>
                <br>
                <br>
                <label for="floatingInput" class="form-label"><b>Username : </b> @<%= post.username %></label>
                <br>
                <br>
                <form action="/posts/upload/<%= post.id %>?_method=PATCH" method="post">
                    
                     <img src="<%= post.image %>" alt="<%= post.username %>" class="post-avatar rounded-circle mb-2">

                      <button class="btn btn-danger btn-sm" >Edit avtar</button>

                </form>
                <form method="post" action="/posts/<%= post.id %>?_method=PATCH" >

                <textarea class="form-control" id="floatingTextarea2"name="content"
                
                    style="height: 100px"><%= post.content %></textarea>
                    <br>
                
                 <button class="btn btn-success btn-sm">Submit</button>
                 </form>
                 <br>
                 <form method="post" action="/posts/<%=post.id %>?_method=DELETE">
                   
                      <button class="btn btn-danger btn-sm" id="btn1">Delete</button>
                      
                 </form>
               
            </div>




        

    </div>

</body>
