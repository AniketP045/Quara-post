<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Upload Avatar</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container-md">
    <!-- PUT the input inside the form -->
    <form action="/posts/upload/<%= post.id %>?_method=PATCH" method="post">
      <div class="mb-3">
        <label for="image" class="form-label">Image URL (path)</label>
        <input id="image" type="text" name="image" class="form-control " placeholder="/images/images.png" value="<%= post.image || '' %>">
        <input type="hidden" name="_method" value="PATCH" >
        
        <!-- submit button (no anchor) -->
        <button type="submit" class="btn btn-primary btn-sm">Upload</button>
        
      </div>
      
    </form>
  </div>
</body>
</html>
